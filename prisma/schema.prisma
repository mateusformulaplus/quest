// Prisma schema for Fórmula Plus Farmácia de Manipulação

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model AdminUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
}

model FormTemplate {
  id          String     @id @default(uuid())
  title       String
  description String
  companyName String     @default("Fórmula Plus Farmácia de Manipulação")
  active      Boolean    @default(true)
  sections    String     // JSON string storing section and question definitions
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  formLinks   FormLink[]
}

model FormLink {
  id              String           @id @default(uuid())
  code            String           @unique
  formTemplateId  String
  formTemplate    FormTemplate     @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  targetPosition  String           // Vaga pretendida
  candidateName   String?          // Opcional se pré-atribuído
  candidateEmail  String?
  candidatePhone  String?
  status          String           @default("PENDING") // PENDING, COMPLETED, EXPIRED
  expiresAt       DateTime?
  createdAt       DateTime         @default(now())
  formSubmissions FormSubmission[]
}

model FormSubmission {
  id                     String    @id @default(uuid())
  formLinkId             String
  formLink               FormLink  @relation(fields: [formLinkId], references: [id], onDelete: Cascade)
  candidateName          String
  candidateEmail         String
  candidatePhone         String
  candidatePosition      String
  answersJson            String    // Stored JSON of all 41 question answers
  signatureName          String
  signatureData          String?   // Base64 image or typed signature
  signatureDate          String
  submittedAt            DateTime  @default(now())
  
  // HR Company Evaluation ("USO EXCLUSIVO DA EMPRESA")
  evaluated              Boolean   @default(false)
  companyEvaluationJson  String?   // JSON of criteria ratings (Baixa, Média, Alta)
  recommendation         String?   // SIM, NAO, AVALIAR_MELHOR
  evaluatorNotes         String?   // Observações do entrevistador
  evaluatedAt            DateTime?
}
